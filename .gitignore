# Rust
# Both trailing-slash and bare forms: these are symlinks to an external drive
# on some dev machines, and a "dir/" pattern does not match a symlink.
target
target/
safesocial_core/target/
**/*.rs.bk
Cargo.lock

# Flutter
safesocial_app/.dart_tool/
safesocial_app/.packages
safesocial_app/.pub/
safesocial_app/build
safesocial_app/build/
safesocial_app/.flutter-plugins
safesocial_app/.flutter-plugins-dependencies
# NOTE: pubspec.lock is intentionally tracked — this is an application, so
# builds should be reproducible.

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

